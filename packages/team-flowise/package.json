{
  "name": "@local/team-flowise",
  "description": "Flowise-like multi-agent team orchestration plugin for DeepSeek Harness (production port of the P1-P5 dynamic prototype, packaged as a composable host bundle).",
  "version": "0.1.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "main": "src/index.js",
  "files": [
    "src",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "multi-agent",
    "orchestration"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Drkoh-wz/team-craft.git",
    "directory": "packages/team-flowise"
  },
  "homepage": "https://github.com/Drkoh-wz/team-craft/tree/main/packages/team-flowise#readme",
  "exports": {
    ".": "./src/index.js",
    "./client": "./src/client/index.js",
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-sidebar-right"
      ],
      "platform": "web"
    }
  },
  "engines": {
    "dsh": ">=0.1.5-rc.1"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-storage": "^0.1.5-rc.2",
    "@deepseek-ai/dsh-subagent": "^0.1.5-rc.2",
    "@deepseek-ai/dsh-system-prompt": "^0.1.5-rc.2",
    "@deepseek-ai/dsh-typert-protocol": "^0.1.5-rc.2"
  },
  "dependencies": {
    "@deepseek-ai/dsh-storage-domain": "^0.1.5-rc.2",
    "@deepseek-ai/dsh-tools": "^0.1.5-rc.2",
    "zod": "^4.4.3"
  }
}
