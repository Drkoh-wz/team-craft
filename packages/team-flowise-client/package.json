{
  "name": "@local/team-flowise-client",
  "description": "Client half of the Flowise-like multi-agent team plugin for DeepSeek Harness: a Settings section page, a session-header team activity panel, and a workflow DAG canvas. Bundled with tsdown into a DSH __ModuleLoader__ client bundle.",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "main": "./dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./client": "./dist/client.js",
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsdown",
    "watch": "tsdown --watch",
    "verify": "node scripts/verify.mjs",
    "test": "node scripts/verify.mjs",
    "test:ui": "node scripts/ui-acceptance.test.mjs",
    "test:ui:offline": "node scripts/ui-acceptance.test.mjs --offline"
  },
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-slots"
      ],
      "platform": "web"
    }
  },
  "devDependencies": {
    "tsdown": "^0.23.0"
  }
}
